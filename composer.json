{
    "name": "manuxi/sulu-association-contact-bundle",
    "description": "Sulu bundle for managing association/membership properties on contacts.",
    "type": "symfony-bundle",
    "keywords": [
        "sulu",
        "suluCms",
        "association",
        "contact",
        "membership"
    ],
    "homepage": "https://github.com/manuxi/SuluAssociationContactBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Manuxi",
            "email": "manu@bytefresser.de"
        }
    ],
    "require": {
        "php": "^8.2",
        "sulu/sulu": "^3.0",
        "symfony/config": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/translation": "^7.0",
        "symfony/security-core": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/browser-kit": "^7.0",
        "symfony/phpunit-bridge": "^7.0",
        "symfony/console": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluAssociationContactBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluAssociationContactBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        }
    }
}
